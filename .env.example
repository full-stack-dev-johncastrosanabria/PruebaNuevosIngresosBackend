# Copiar a .env antes de levantar el sistema:  cp .env.example .env
# El archivo .env esta en .gitignore y nunca debe versionarse.

POSTGRES_DB=pedidos
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=cambiar_en_produccion

ORDER_MS_PORT=8080
PAYMENT_MS_PORT=8081
FRONTEND_PORT=4200
POSTGRES_PORT=5432
KAFKA_EXTERNAL_PORT=29092

# Monto a partir del cual el cobro simulado se rechaza.
# Permite reproducir el camino de fallo de forma determinista.
PAYMENT_DECLINE_THRESHOLD=1000.00
PAYMENT_PROCESSING_DELAY_MS=1500
